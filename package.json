{
  "name": "myLucky",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit",
    "lint": "biome lint ./src",
    "format": "biome format ./src --write",
